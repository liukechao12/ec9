# EC9 报名系统配置模板
# 用法：复制为 .env（本地）或 .env.production.local（生产，均不进 git）并填入真实值
# 数据库：PostgreSQL（不是 MySQL）

# ── 服务器 ──
NODE_ENV=development            # 生产改为 production（会触发启动自检：FRONTEND_URL 必须是 https 真实域名）
PORT=7098
HOST=0.0.0.0
CORS_ORIGIN=*

# ── 数据库（PostgreSQL）──
# 生产库：独立实例；本地开发可指向同一库（严禁指向生产库跑测试脚本）
DB_HOST=101.96.212.13
DB_PORT=5432
DB_NAME=ec9
DB_USER=ec9
DB_PASSWORD=

# ── 安全密钥（缺失或过短会拒绝启动）──
# 生成：JWT_SECRET=openssl rand -hex 32
#      ENCRYPTION_KEY=openssl rand -hex 16   （AES 加密手机号，必须正好 32 字符）
#      PHONE_HMAC_KEY=openssl rand -hex 32   （手机号检索索引，不可逆）
# ⚠️ 三项一旦投入使用不可更改，否则历史手机号密文/索引全部失效
JWT_SECRET=
JWT_EXPIRES_IN=604800
ENCRYPTION_KEY=
PHONE_HMAC_KEY=

# ── 前端地址（短信付款链接 / 电子票链接的前缀）──
# ⚠️ 生产必须配真实 https 域名，否则发给用户的付款链接是 localhost，打不开
# NODE_ENV=production 时若缺失、指向 localhost 或非 https，服务拒绝启动
FRONTEND_URL=http://localhost:7098

# ── 微信支付 ──
# mock = 模拟支付（不接微信，可走完流程）/ native = 扫码 / jsapi = 公众号内支付
WXPAY_MODE=mock
WXPAY_APP_ID=
WXPAY_MCH_ID=
WXPAY_API_KEY=
WXPAY_NOTIFY_URL=/api/payment/notify   # 必须是公网可访问地址，微信回调用它
WXPAY_CERT_PATH=                        # apiclient_cert.p12 绝对路径
WXPAY_REFUND_NOTIFY_URL=
WXPAY_SIGN_TYPE=MD5

# ── 短信 ──
# 服务商凭证已迁移到数据库（后台「短信配置」页维护，改完免重启），此处只留开关
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=
SMS_VERIFICATION_CODE_TEMPLATE=
SMS_VERIFICATION_CODE_SIGN=
SMS_CODE_EXPIRE_MINUTES=5
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
SMS_CODE_DAILY_LIMIT=10

# ── 业务 ──
VERIFICATION_TOKEN_EXPIRE_HOURS=2      # 手机验证凭证有效期（支付/查单靠它）
